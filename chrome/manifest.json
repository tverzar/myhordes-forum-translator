{
  "manifest_version": 3,
  "name": "MyHordes Forum Translator",
  "version": "1.0.0",
  "description": "Translates MyHordes forum posts between French, English, Russian and Spanish (Google Translate, MyMemory, DeepL or Yandex).",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*",
    "https://api.mymemory.translated.net/*",
    "https://translate.api.cloud.yandex.net/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://myhordes.eu/*", "*://*.myhordes.eu/*",
        "*://myhordes.de/*", "*://*.myhordes.de/*",
        "*://myhordes.fr/*", "*://*.myhordes.fr/*",
        "*://myhordes.com/*", "*://*.myhordes.com/*"
      ],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "MyHordes Forum Translator",
    "default_popup": "options/options.html"
  }
}
